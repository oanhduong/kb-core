# =====================================================================================
# RetailKB Copilot — biến môi trường (secret + endpoint). Tham số ảnh hưởng kết quả nằm ở config.yaml.
#   cp .env.example .env   rồi điền MỌI biến đánh dấu [BẮT BUỘC].
# Sinh secret ngẫu nhiên:  openssl rand -hex 32
# =====================================================================================

# ---------- [BẮT BUỘC] ----------
# Mật khẩu Postgres (dùng chung cho DB retailkb + DB langfuse)
POSTGRES_PASSWORD=
# API key Anthropic — trả lời câu hỏi, phân loại, vision cho ảnh/PDF scan, LLM extraction graph
ANTHROPIC_API_KEY=
# anthropic (mặc định, dùng ANTHROPIC_API_KEY) | claude_cli: gọi Claude Code CLI đã `claude /login` bằng
# subscription — CHỈ cho máy dev cá nhân, không dùng production. CLAUDE_CLI_PATH trống = tìm `claude` trong PATH.
LLM_PROVIDER=anthropic
CLAUDE_CLI_PATH=
# Ký JWT cho user (>= 32 ký tự ngẫu nhiên)
JWT_SECRET=
# Tài khoản superadmin đầu tiên (đăng nhập web). Migration tạo user này và gán workspace mặc định khi DB còn trống.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=
# API key hệ thống (header X-API-Key, quyền superadmin) — cho script/CI. Dạng rk_<chuỗi ngẫu nhiên>
BOOTSTRAP_ADMIN_API_KEY=rk_change_me_to_a_long_random_string
# Langfuse self-host: key project được tạo sẵn lúc khởi động (đặt giá trị bất kỳ đúng tiền tố)
LANGFUSE_PUBLIC_KEY=pk-lf-retailkb-change-me
LANGFUSE_SECRET_KEY=sk-lf-retailkb-change-me
LANGFUSE_NEXTAUTH_SECRET=
LANGFUSE_SALT=
# Đăng nhập Langfuse UI (http://localhost:3001) bằng LANGFUSE_ADMIN_EMAIL / mật khẩu này
LANGFUSE_ADMIN_PASSWORD=

# ---------- Tuỳ chọn ----------
POSTGRES_USER=retail
POSTGRES_DB=retailkb
LANGFUSE_ADMIN_EMAIL=admin@retailkb.local
# URL Langfuse mà người dùng mở trên trình duyệt (link trace trong Admin UI / API)
LANGFUSE_PUBLIC_URL=http://localhost:3001

# Môi trường: production đặt APP_ENV=prod. CORS chỉ cần khi web chạy khác origin với api (dev Vite :5173).
APP_ENV=dev
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# Thư mục parquet của bảng số liệu (DuckDB đọc trực tiếp). Compose dùng volume /app/data/tables
# TABLES_DIR=data/tables

# Rollback config: chọn snapshot config/versions/<version>.yaml (trống = dùng config.yaml). Xem docs/OPERATIONS.md
RETAILKB_CONFIG_VERSION=

# Alert (E3): slack | telegram | generic
ALERT_CHANNEL=slack
ALERT_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Ghi đè nhanh vài tham số config (giá trị mặc định nằm trong config.yaml)
# EMBEDDING_PROVIDER=hashing      # dev offline không tải model embedding
# RERANK_ENABLED=false            # tắt cross-encoder (máy yếu)
# GRAPH_ENABLED=false             # tắt graph, mọi câu đi vector
# INGEST_SANDBOX_MODE=sidecar     # sidecar (mặc định compose) | none | docker

LOG_LEVEL=INFO
LOG_FORMAT=json
API_WORKERS=2
WHISPER_MODEL_SIZE=small
PARSER_MEM_LIMIT=3g
BACKUP_KEEP_DAYS=14

# Cổng publish ra host
API_PORT=8000
WEB_PORT=3000
LANGFUSE_PORT=3001
POSTGRES_PORT=5432
