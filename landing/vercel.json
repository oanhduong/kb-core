{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "sh build-standalone.sh",
  "outputDirectory": "dist",
  "framework": null,
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/wow",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/wow/",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/chat",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/chat/",
      "destination": "/",
      "permanent": false
    }
  ]
}
